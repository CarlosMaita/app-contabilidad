# Copiar a .env en el VPS y completar. Generar APP_KEY con:
#   docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show

APP_NAME="App Contabilidad"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://contabilidad.example.com

# Dominio para el TLS automático de Caddy
APP_DOMAIN=contabilidad.example.com
ACME_EMAIL=admin@example.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# Logs a stderr para verlos con `docker compose logs`
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=contabilidad
DB_USERNAME=contabilidad
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# SMTP para verificación de email y reset de contraseña (obligatorio)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@contabilidad.example.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
